<odoo>


<record id="account_chart_import_form" model="ir.ui.view">
    <field name="name">account.chart.import.form</field>
    <field name="model">account.chart.import</field>
    <field name="arch" type="xml">
        <form>
            <div name="help">
                <p
                        >The XLSX file to import must have 2 columns with an optional third column:</p>
                <ul><li>A. Account Code (required)</li>
                        <li>B. Account Name (required)</li>
                        <li>C. Internal Notes (optional)</li>
        </ul>
            </div>
            <group name="main">
                <field name="company_ids" widget="many2many_tags" />
                <!--    <field name="with_taxes" /> -->
                <field name="input_file" filename="input_filename" />
                <field name="input_filename" invisible="1" />
                <field name="input_sheet_number"/>
                <field name="input_start_line"/>
                <field name="fixed_size_code" />
                <field name="source_module" widget="radio"/>
                <field name="delete_existing_accounts" widget="radio"/>
                <field name="create_unaffected_earnings_account"/>
            </group>
            <footer>
                <button
                        name="run"
                        type="object"
                        string="Import"
                        class="btn-primary"
                    />
                <button
                        special="cancel"
                        string="Close"
                    />
            </footer>
        </form>
    </field>
</record>

<record id="account_chart_import_action" model="ir.actions.act_window">
    <field name="name">Import Chart of Accounts</field>
    <field name="res_model">account.chart.import</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

<menuitem
        id="account_chart_tools_parent_menu"
        parent="account.menu_finance_configuration"
        name="Tools for Chart of Accounts"
        sequence="1"
    />

<menuitem
        id="account_chart_import_menu"
        parent="account_chart_tools_parent_menu"
        action="account_chart_import_action"
    />


</odoo>
