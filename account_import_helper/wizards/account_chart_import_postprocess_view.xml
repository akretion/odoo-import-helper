<odoo>


<record id="account_chart_import_postprocess_form" model="ir.ui.view">
    <field name="name">account.chart.import.postprocess.form</field>
    <field name="model">account.chart.import.postprocess</field>
    <field name="arch" type="xml">
        <form>
            <group name="required" string="Required Fields">
                <field name="company_id" />
                <field name="partner_receivable_account_id"/>
                <field name="partner_receivable_account_default_id" invisible="1"/>
                <field name="partner_payable_account_id"/>
                <field name="partner_payable_account_default_id" invisible="1"/>
                <field name="product_categ_income_account_id"/>
                <field name="product_categ_income_account_default_id" invisible="1"/>
                <field name="product_categ_expense_account_id"/>
                <field name="product_categ_expense_account_default_id" invisible="1"/>
            </group>
            <group name="required" string="Optional Fields">
                <field name="suspense_account_id"/>
                <field name="transfer_account_id"/>
            </group>
            <footer>
                <button name="run" type="object" string="Update" class="btn-primary" />
                <button special="cancel" string="Cancel" />
            </footer>
        </form>
    </field>
</record>

<record id="account_chart_import_postprocess_action" model="ir.actions.act_window">
    <field name="name">Re-configure after Chart of Account Import</field>
    <field name="res_model">account.chart.import.postprocess</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

<menuitem
        id="account_chart_import_postprocess_menu"
        parent="account_chart_tools_parent_menu"
        action="account_chart_import_postprocess_action"
        sequence="20"
    />


</odoo>
