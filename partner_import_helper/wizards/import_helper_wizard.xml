<odoo>
    <record id="import_helper_form" model="ir.ui.view">
        <field name="model">import.helper</field>
        <field name="inherit_id" ref="import_helper_base.import_helper_form" />

        <field name="arch" type="xml">
            <group name="main" position="inside">
                <button name="%(action_partner_import_helper_download_template)d"
                    type="action" icon="fa-download"
                    class="mb-4 btn btn-secondary"
                >
                    Download XLSX template
                </button>

                <field name="file" />
                <field name="ai_engine" />
            </group>
            <footer position="inside">
                <button type="object"
                    name="button_import_partner"
                    class="btn btn-primary"
                    string="Import Partners"
                />
            </footer>
        </field>
    </record>
    
    <record id="partner_import_helper_wizard_action" model="ir.actions.act_window">
        <field name="name">Partner Import Helper</field>
        <field name="res_model">import.helper</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="partner_import_helper_menu"
        parent="import_helper_base.import_helper_parent_menu"
        action="partner_import_helper_wizard_action"
    />

    <!-- Action Download tempalte -->
    <record id="action_partner_import_helper_download_template" model="ir.actions.act_url">
        <field name="name">Download partner XLSX template</field>
        <field name="url">/partner_import_helper/static/xls/partner_import_helper_template.xlsx</field>
        <field name="target">download</field>
    </record>
</odoo>
